# =============================================================================
# AgentOps Copilot — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is git-ignored.
# =============================================================================

# --- Supabase (required from D3) ---------------------------------------------
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# --- Supabase JWT (required from D5) -----------------------------------------
SUPABASE_JWT_SECRET=

# --- LLM APIs (required from D18) --------------------------------------------
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Google OAuth (required from D7) -----------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Backend callback URL — must be whitelisted in Google Cloud Console → Credentials.
# D8 will add the actual handler; D7 only needs this URI to build the auth URL.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/google/callback

# --- GitHub OAuth (required from D10) ----------------------------------------
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Slack OAuth (required from D10) -----------------------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# --- Cron / Internal jobs (required from D9) ---------------------------------
# Secure the internal sweep endpoint. Use a long random string (e.g. openssl rand -hex 32).
CRON_SECRET=

# --- Resend (outbound email, required from D15) -------------------------------
# Sign up at https://resend.com — free tier: 3,000 emails/month.
# RESEND_FROM_ADDRESS must be a verified sender domain in your Resend account.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=agentops@yourdomain.com

# --- Firebase Cloud Messaging (required from D24) ----------------------------
FCM_SERVER_KEY=

# --- Render deployment (required from D34) -----------------------------------
RENDER_DEPLOY_HOOK_URL=
